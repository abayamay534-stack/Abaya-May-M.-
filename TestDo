import java.util.Scanner;

public class TestDo {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int data;
        int sum = 0;

        do {
            System.out.print("Enter an int value (0 to exit): ");
            data = input.nextInt();
            sum += data;
        } while (data != 0);

        System.out.println("The sum is " + sum);

        input.close();
    }
